# Supabase → Project Settings → API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable key (sb_publishable_...) или legacy anon key
VITE_SUPABASE_KEY=sb_publishable_xxx

# Обязательно: из имени бота строится ссылка-приглашение в компанию
VITE_BOT_USERNAME=my_wishlist_bot
# Short name мини-приложения из BotFather (/newapp). Без него ссылка ведёт на Main Mini App бота
VITE_APP_SHORT_NAME=wishlist

# Валюту выбирают при создании компании — здесь её задавать не нужно
